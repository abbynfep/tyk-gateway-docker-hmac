{
    "api_id": "carrier-webhook",
    "name": "carrier-webhook",
    "org_id": "default",
    "enable_signature_checking": true,
    "hmac_allowed_algorithms": ["hmac-sha256", "hmac-sha384", "hmac-sha512"],
    "hmac_allowed_clock_skew": 3000,
    "domain_disabled": false,
    "version_data": {
        "not_versioned": true,
        "versions": {
            "Default": {
                "name": "Default",
                "global_headers_remove": [
                    "Authorization"
                ]
            }
        }
    },
    "global_rate_limit": {
        "rate": 1000,
        "per": 1,
        "disabled": false
    },
    "proxy": {
        "listen_path": "/public/carrier/webhookTracking",
        "target_url": "https://echo.free.beeceptor.com",
        "strip_listen_path": true
    }
}
